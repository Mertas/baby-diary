# Скопируйте в .env и заполните (npm run dev читает его через dotenv)
PORT=1911
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
LLM_TIMEOUT_MS=60000
# Путь к БД (по умолчанию ./data/babydiary.db)
# DB_PATH=./data/babydiary.db

# ── Бесплатные LLM-провайдеры (опционально) ──
# OpenRouter: https://openrouter.ai — бесплатный ключ, модели с :free бесплатны.
# Их модели появятся в селекте модели автоматически.
# OPENROUTER_API_KEY=
# Groq: https://console.groq.com — бесплатный тариф (fast inference).
# GROQ_API_KEY=
