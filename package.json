{
  "name": "babydiary",
  "version": "1.0.0",
  "description": "Baby diary with integrated LLM chat",
  "type": "module",
  "scripts": {
    "dev": "npm run build:client && tsx watch src/server/index.ts",
    "start": "npm run build:client && tsx src/server/index.ts",
    "build:client": "esbuild src/client/*.ts --outdir=dist/client/ --format=iife --bundle",
    "build": "npm run build:client && tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "openai": "^4.52.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.1": true
  }
}
